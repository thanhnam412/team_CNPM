model QuickTask {
  id             String          @id @default(uuid())
  clientId       String
  expertId       String?
  title          String
  description    String
  requirements   String?
  tags           Json?
  attachments    Json?
  status         QuickTaskStatus @default(OPEN)
  budget         Decimal         @default(0.0)
  deadline       DateTime?
  proposalsCount Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  client         User            @relation("ClientQuickTasks", fields: [clientId], references: [id], onDelete: Cascade)
  expert         User?           @relation("ExpertQuickTasks", fields: [expertId], references: [id])
  
  contract       Contract?
  proposals      Proposal[]
  invitations    Invitation[]

  @@map("quick_tasks")
}

model Contract {
  id           String   @id @default(uuid())
  quickTaskId  String?  @unique
  milestoneId  String?  @unique
  expertId     String
  clientId     String
  agreedPrice  Decimal
  escrowStatus String   @default("HELD")
  deadline     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quickTask    QuickTask?    @relation(fields: [quickTaskId], references: [id], onDelete: Cascade)
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  expert       ExpertProfile @relation(fields: [expertId], references: [userId])
  client       ClientProfile @relation(fields: [clientId], references: [userId])
  payments     Payment[]

  @@map("contracts")
}

model Proposal {
  id            String         @id @default(uuid())
  quickTaskId   String?
  milestoneId   String?
  expertId      String
  coverLetter   String
  proposedPrice Decimal
  estimatedDays Int
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  quickTask     QuickTask?     @relation(fields: [quickTaskId], references: [id], onDelete: Cascade)
  milestone     Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  expert        ExpertProfile  @relation(fields: [expertId], references: [userId], onDelete: Cascade)
  negotiations  ProposalNegotiation[]

  @@map("proposals")
}

model ProposalNegotiation {
  id            String         @id @default(uuid())
  proposalId    String
  actorId       String
  actorRole     String         // "CLIENT" or "EXPERT"
  offeredPrice  Decimal
  status        String         @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime       @default(now())

  proposal      Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_negotiations")
}

model Invitation {
  id          String           @id @default(uuid())
  clientId    String
  expertId    String
  projectId   String?
  quickTaskId String?
  milestoneId String?
  message     String?
  budget      Decimal?
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  client      ClientProfile    @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  expert      ExpertProfile    @relation(fields: [expertId], references: [userId], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id])
  quickTask   QuickTask?       @relation(fields: [quickTaskId], references: [id])
  milestone   Milestone?       @relation(fields: [milestoneId], references: [id])

  @@map("invitations")
}

enum QuickTaskStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  COMPLETED
  DISPUTE
  SYSTEM_RESOLVING
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}
