model Project {
  id               String          @id @default(uuid())
  title            String
  description      String?
  requirements     String?
  industry         String?
  tags             Json?
  attachmentsCount Int             @default(0)
  links            Json?
  startDate        DateTime?
  endDate          DateTime?
  status           String          @default("ACTIVE")
  budget           Decimal         @default(0.0)
  spent            Decimal         @default(0.0)
  escrow           Decimal         @default(0.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  milestones       Milestone[]
  members          ProjectMember[]
  tasks            Task[]
  invitations      Invitation[]
  transactions     Transaction[]

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(CLIENT_ADMIN)
  status    String      @default("ACTIVE")
  rating    Float?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Milestone {
  id           String          @id @default(uuid())
  projectId    String
  assigneeId   String?
  title        String
  description  String?
  budget       Decimal         @default(0.0)
  status       MilestoneStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?           @relation("MilestoneAssignee", fields: [assigneeId], references: [id])
  
  contract     Contract?
  proposals    Proposal[]
  tasks        Task[]
  invitations  Invitation[]

  @@map("milestones")
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  milestoneId String?
  title       String
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  comments    Int          @default(0)
  attachments Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id])
  assignee    User?        @relation(fields: [assigneeId], references: [id])
  
  payments    Payment[]

  @@map("tasks")
}

enum ProjectRole {
  CLIENT_ADMIN
  INTERNAL_TEAM
  EXPERT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum MilestoneStatus {
  PENDING
  ACTIVE
  REVIEW
  PAID
}
