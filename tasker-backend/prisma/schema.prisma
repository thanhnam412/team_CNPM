datasource db {
  provider = "postgresql"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../src/database"
  fileName = "types.ts"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}
